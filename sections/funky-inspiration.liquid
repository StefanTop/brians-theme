{% comment %}
  Inspiration section: heading and copy on one side, an asymmetric four-image
  grid on the other.
{% endcomment %}

<section class="funky-inspiration">
  <div class="funky-inspiration__inner">
    <div class="funky-inspiration__content">
      <h2 class="funky-inspiration__heading">{{ section.settings.heading }}</h2>
      <p class="funky-inspiration__text">{{ section.settings.text_1 }}</p>
      {% if section.settings.text_2 != blank %}
        <p class="funky-inspiration__text">{{ section.settings.text_2 }}</p>
      {% endif %}
      <div class="funky-inspiration__actions">
        <a href="{{ section.settings.button_url | default: '#' }}" class="funky-button funky-button--dark">{{ section.settings.button_label }}</a>
        {% if section.settings.link_label != blank %}
          <a href="{{ section.settings.link_url | default: '#' }}" class="funky-inspiration__link">{{ section.settings.link_label }}</a>
        {% endif %}
      </div>
    </div>

    <div class="funky-inspiration__grid">
      {% for block in section.blocks limit: 4 %}
        <div class="funky-inspiration__image funky-inspiration__image--{{ forloop.index }}" {{ block.shopify_attributes }}>
          {% if block.settings.image %}
            {{ block.settings.image | image_url: width: 700 | image_tag }}
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
  .funky-inspiration {
    font-family: var(--funky-font-body, "Inter", sans-serif);
  }

  .funky-inspiration__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 56px;
    align-items: center;
    max-width: 1326px;
    margin: 0 auto;
    padding: 96px 48px;
  }

  .funky-inspiration__content {
    display: flex;
    flex-direction: column;
    gap: 20px;
    max-width: 440px;
  }

  .funky-inspiration__heading {
    margin: 0;
    font-family: var(--funky-font-display, "Baloo 2", sans-serif);
    font-size: 34px;
    font-weight: 800;
    color: var(--funky-navy, #1f2049);
  }

  .funky-inspiration__text {
    margin: 0;
    font-size: 15px;
    line-height: 1.5;
    color: #6f6f80;
  }

  .funky-inspiration__actions {
    display: flex;
    align-items: center;
    gap: 24px;
    margin-top: 8px;
  }

  .funky-inspiration__link {
    font-size: 14px;
    font-weight: 600;
    text-decoration: underline;
    color: var(--funky-navy, #1f2049);
  }

  .funky-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: fit-content;
    padding: 16px 32px;
    border-radius: 999px;
    font-weight: 700;
    font-size: 15px;
    text-decoration: none;
    transition: transform 200ms ease-out, background-color 200ms ease-out;
  }

  .funky-button--dark {
    background-color: var(--funky-navy, #1f2049);
    color: #fcfcf7;
  }

  .funky-button--dark:hover {
    background-color: #ff6a20;
  }

  .funky-inspiration__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: repeat(3, 140px);
    gap: 16px;
  }

  .funky-inspiration__image {
    border-radius: 12px;
    overflow: hidden;
    background-color: #f0f0f2;
  }

  .funky-inspiration__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .funky-inspiration__image--1 {
    grid-column: 1;
    grid-row: 1 / 3;
  }

  .funky-inspiration__image--2 {
    grid-column: 2;
    grid-row: 1;
  }

  .funky-inspiration__image--3 {
    grid-column: 2;
    grid-row: 2 / 4;
  }

  .funky-inspiration__image--4 {
    grid-column: 1;
    grid-row: 3;
  }

  @media (max-width: 900px) {
    .funky-inspiration__inner {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Funky inspiration",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Take the inspiration" },
    { "type": "textarea", "id": "text_1", "label": "Text 1", "default": "Lorem ipsum dolor sit amet consectetur. Eu pellentesque in platea feugiat netus et lorem." },
    { "type": "textarea", "id": "text_2", "label": "Text 2", "default": "Nisl tellus justo duis velit. Neque aenean auctor egestas mauris commodo consequat in vitae." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Verder winkelen" },
    { "type": "url", "id": "button_url", "label": "Button link" },
    { "type": "text", "id": "link_label", "label": "Secondary link label", "default": "Bekijk alle inspiratie" },
    { "type": "url", "id": "link_url", "label": "Secondary link" }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [{ "type": "image_picker", "id": "image", "label": "Image" }]
    }
  ],
  "presets": [
    {
      "name": "Funky inspiration",
      "blocks": [
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
