{% comment %}
  Full-width strip of square photos, e.g. an Instagram-style gallery.
{% endcomment %}

<div class="funky-photo-strip">
  <div class="funky-photo-strip__inner">
    {% for block in section.blocks %}
      <div class="funky-photo-strip__item" {{ block.shopify_attributes }}>
        {% if block.settings.image %}
          {{ block.settings.image | image_url: width: 500 | image_tag }}
        {% endif %}
      </div>
    {% endfor %}
  </div>
</div>

{% stylesheet %}
  .funky-photo-strip__inner {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    max-width: 1326px;
    margin: 0 auto;
    padding: 0 48px 48px;
  }

  .funky-photo-strip__item {
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background-color: #f0f0f2;
  }

  .funky-photo-strip__item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 900px) {
    .funky-photo-strip__inner {
      grid-template-columns: repeat(3, 1fr);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Funky photo strip",
  "blocks": [
    {
      "type": "photo",
      "name": "Photo",
      "settings": [{ "type": "image_picker", "id": "image", "label": "Image" }]
    }
  ],
  "presets": [
    {
      "name": "Funky photo strip",
      "blocks": [
        { "type": "photo" },
        { "type": "photo" },
        { "type": "photo" },
        { "type": "photo" },
        { "type": "photo" },
        { "type": "photo" }
      ]
    }
  ]
}
{% endschema %}
