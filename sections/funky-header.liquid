{% comment %}
  Funky site header: category navigation on the left, centered logo, and
  utility icons (search, account, cart) on the right.
{% endcomment %}

<header class="funky-header">
  <div class="funky-header__inner">
    <nav class="funky-header__nav">
      {% for block in section.blocks %}
        <a href="{{ block.settings.url | default: '#' }}" class="funky-header__nav-link" {{ block.shopify_attributes }}>
          {{ block.settings.title }}
        </a>
      {% endfor %}
    </nav>

    <a href="{{ routes.root_url }}" class="funky-header__logo">
      {% if section.settings.logo %}
        {{ section.settings.logo | image_url: width: 200 | image_tag }}
      {% else %}
        {{ shop.name }}
      {% endif %}
    </a>

    <div class="funky-header__icons">
      <a href="{{ routes.search_url }}" class="funky-header__icon" aria-label="Zoeken">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--funky-navy, #1f2049)" stroke-width="2">
          <circle cx="11" cy="11" r="7"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </a>

      {% if shop.customer_accounts_enabled %}
        <shopify-account menu="{{ section.settings.customer_account_menu }}" class="funky-header__icon">
          {{ 'icon-account.svg' | inline_asset_content }}
        </shopify-account>
      {% else %}
        <a href="{{ routes.account_url }}" class="funky-header__icon" aria-label="Account">
          {{ 'icon-account.svg' | inline_asset_content }}
        </a>
      {% endif %}

      <a href="{{ routes.cart_url }}" class="funky-header__cart" aria-label="Winkelwagen">
        {{ 'icon-cart.svg' | inline_asset_content }}
        {% if cart.item_count > 0 %}
          <span class="funky-header__cart-count">{{ cart.item_count }}</span>
        {% endif %}
      </a>
    </div>
  </div>
</header>

{% stylesheet %}
  .funky-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--funky-cream, #fcfcf7);
    border-bottom: 1.5px solid rgba(31, 32, 73, 0.15);
    font-family: var(--funky-font-body, "Inter", sans-serif);
  }

  .funky-header__inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 24px;
    max-width: 1326px;
    margin: 0 auto;
    padding: 17px 32px;
  }

  .funky-header__nav {
    display: flex;
    align-items: center;
    gap: 24px;
    min-width: 0;
  }

  .funky-header__nav-link {
    font-size: 13px;
    font-weight: 500;
    color: var(--funky-navy, #1f2049);
    text-decoration: none;
    white-space: nowrap;
  }

  .funky-header__nav-link:hover {
    color: var(--funky-orange-dark, #e8550f);
  }

  .funky-header__logo {
    grid-column: 2;
    justify-self: center;
    display: flex;
    align-items: center;
    font-family: var(--funky-font-display, "Baloo 2", sans-serif);
    font-weight: 800;
    font-size: 22px;
    letter-spacing: 0.02em;
    color: var(--funky-navy, #1f2049);
    text-decoration: none;
  }

  .funky-header__logo img {
    height: 44px;
    object-fit: contain;
    display: block;
  }

  .funky-header__icons {
    grid-column: 3;
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 20px;
    flex-shrink: 0;
  }

  .funky-header__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--funky-navy, #1f2049);
    --icon-stroke-width: 1.6;
  }

  .funky-header__icon svg {
    width: 22px;
    height: 22px;
  }

  .funky-header__cart {
    position: relative;
    background-color: var(--funky-orange, #ff6a1f);
    color: var(--funky-cream, #fcfcf7);
    --icon-stroke-width: 1.6;
    width: 44px;
    height: 44px;
    border-radius: 999px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: transform 200ms ease-out;
  }

  .funky-header__cart svg {
    width: 22px;
    height: 22px;
  }

  .funky-header__cart:hover {
    transform: scale(1.08);
  }

  .funky-header__cart-count {
    position: absolute;
    top: -8px;
    right: -10px;
    width: 22px;
    height: 22px;
    border-radius: 999px;
    background-color: var(--funky-navy, #1f2049);
    color: var(--funky-cream, #fcfcf7);
    font-size: 12px;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  @media (max-width: 900px) {
    .funky-header__inner {
      grid-template-columns: auto 1fr auto;
      padding: 14px 20px;
    }

    .funky-header__nav {
      display: none;
    }

    .funky-header__logo {
      grid-column: 1;
      justify-self: start;
    }

    .funky-header__icons {
      grid-column: 3;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Funky header",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    {
      "type": "link_list",
      "id": "customer_account_menu",
      "label": "Customer account menu",
      "default": "customer-account-main-menu"
    }
  ],
  "blocks": [
    {
      "type": "nav_link",
      "name": "Navigation link",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Link" },
        { "type": "url", "id": "url", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Funky header",
      "blocks": [
        { "type": "nav_link", "settings": { "title": "Meubels", "url": "#meubels" } },
        { "type": "nav_link", "settings": { "title": "Spiegels", "url": "#spiegels" } },
        { "type": "nav_link", "settings": { "title": "Verlichting", "url": "#verlichting" } },
        { "type": "nav_link", "settings": { "title": "Accessoires", "url": "#accessoires" } }
      ]
    }
  ]
}
{% endschema %}
