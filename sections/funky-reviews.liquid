{% comment %}
  Customer testimonials on a soft grey panel, presented as a horizontally
  scrollable slider with prev/next arrows and a progress bar.
{% endcomment %}

<section class="funky-reviews">
  <h2 class="funky-reviews__heading">{{ section.settings.heading }}</h2>

  <funky-carousel class="funky-reviews__carousel">
    <div class="funky-reviews__track" data-funky-carousel-track>
      {% for block in section.blocks %}
        <div class="funky-reviews__card" data-funky-carousel-item {{ block.shopify_attributes }}>
          <div class="funky-reviews__stars">★★★★★</div>
          <div class="funky-reviews__name">{{ block.settings.name }}</div>
          <p class="funky-reviews__text">{{ block.settings.text }}</p>
        </div>
      {% endfor %}
    </div>

    <div class="funky-reviews__controls">
      <button type="button" class="funky-reviews__arrow" data-funky-carousel-prev aria-label="Vorige">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--funky-navy, #1f2049)" stroke-width="2"><path d="M15 18l-6-6 6-6"></path></svg>
      </button>
      <div class="funky-reviews__progress-track">
        <div class="funky-reviews__progress-fill" data-funky-carousel-progress></div>
      </div>
      <button type="button" class="funky-reviews__arrow" data-funky-carousel-next aria-label="Volgende">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--funky-navy, #1f2049)" stroke-width="2"><path d="M9 18l6-6-6-6"></path></svg>
      </button>
    </div>
  </funky-carousel>
</section>

{% stylesheet %}
  .funky-reviews {
    margin: 0 48px 96px;
    padding: 56px 40px;
    border-radius: 16px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 40px;
    background-color: #f0f0f2;
    font-family: var(--funky-font-body, "Inter", sans-serif);
  }

  .funky-reviews__heading {
    margin: 0;
    text-align: center;
    font-family: var(--funky-font-display, "Baloo 2", sans-serif);
    font-size: 34px;
    font-weight: 800;
    color: var(--funky-navy, #1f2049);
  }

  .funky-reviews__carousel {
    display: flex;
    flex-direction: column;
    gap: 24px;
    width: 100%;
    max-width: 1100px;
  }

  .funky-reviews__track {
    display: flex;
    gap: 24px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .funky-reviews__track::-webkit-scrollbar {
    display: none;
  }

  .funky-reviews__card {
    flex: 1 0 calc(33.333% - 16px);
    min-width: 260px;
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 20px;
    border: 1.5px solid rgba(31, 32, 73, 0.15);
    border-radius: 16px;
    background: #fff;
  }

  .funky-reviews__stars {
    color: var(--funky-navy, #1f2049);
    font-size: 14px;
    letter-spacing: 2px;
  }

  .funky-reviews__name {
    font-weight: 700;
    color: var(--funky-navy, #1f2049);
    font-size: 15px;
  }

  .funky-reviews__text {
    margin: 0;
    font-size: 14px;
    line-height: 1.5;
    color: #6f6f80;
  }

  .funky-reviews__controls {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .funky-reviews__arrow {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #fff;
    border: 1.5px solid rgba(31, 32, 73, 0.15);
    border-radius: 999px;
    cursor: pointer;
  }

  .funky-reviews__arrow:disabled {
    opacity: 0.35;
    cursor: default;
  }

  .funky-reviews__progress-track {
    flex: 1;
    height: 4px;
    background: #fff;
    border-radius: 999px;
    overflow: hidden;
  }

  .funky-reviews__progress-fill {
    width: 0%;
    height: 100%;
    background: var(--funky-navy, #1f2049);
    border-radius: 999px;
    transition: width 150ms ease;
  }

  @media (max-width: 700px) {
    .funky-reviews__card {
      flex-basis: 85%;
    }
  }
{% endstylesheet %}

{% javascript %}
  class FunkyCarousel extends HTMLElement {
    connectedCallback() {
      this.track = this.querySelector('[data-funky-carousel-track]');
      this.prevButton = this.querySelector('[data-funky-carousel-prev]');
      this.nextButton = this.querySelector('[data-funky-carousel-next]');
      this.progressFill = this.querySelector('[data-funky-carousel-progress]');

      if (!this.track) return;

      this.onPrev = this.onPrev.bind(this);
      this.onNext = this.onNext.bind(this);
      this.onScroll = this.onScroll.bind(this);

      this.prevButton?.addEventListener('click', this.onPrev);
      this.nextButton?.addEventListener('click', this.onNext);
      this.track.addEventListener('scroll', this.onScroll, { passive: true });
      window.addEventListener('resize', this.onScroll);

      this.updateUI();
    }

    disconnectedCallback() {
      window.removeEventListener('resize', this.onScroll);
    }

    onPrev() {
      this.track.scrollBy({ left: -this.track.clientWidth, behavior: 'smooth' });
    }

    onNext() {
      this.track.scrollBy({ left: this.track.clientWidth, behavior: 'smooth' });
    }

    onScroll() {
      window.requestAnimationFrame(() => this.updateUI());
    }

    updateUI() {
      const maxScroll = this.track.scrollWidth - this.track.clientWidth;
      const progress = maxScroll > 0 ? this.track.scrollLeft / maxScroll : 0;

      if (this.progressFill) {
        this.progressFill.style.width = `${Math.max(0, Math.min(1, progress)) * 100}%`;
      }
      if (this.prevButton) this.prevButton.disabled = this.track.scrollLeft <= 1;
      if (this.nextButton) this.nextButton.disabled = this.track.scrollLeft >= maxScroll - 1;
    }
  }

  customElements.define('funky-carousel', FunkyCarousel);
{% endjavascript %}

{% schema %}
{
  "name": "Funky reviews",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Onze klanten aan het woord" }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "default": "Naam" },
        { "type": "textarea", "id": "text", "label": "Quote" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Funky reviews",
      "blocks": [
        { "type": "testimonial", "settings": { "name": "Nina P.", "text": "Snelle levering en de kleur is nog mooier in het echt. Past precies in ons interieur." } },
