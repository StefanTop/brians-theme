{% comment %}
  Trust bar with benefit callouts (icon, title, subtitle), presented as a
  horizontally scrollable slider with prev/next arrows and a progress bar,
  matching the reviews slider's control style.
{% endcomment %}

<section class="funky-benefits">
  <funky-carousel class="funky-benefits__carousel">
    <div class="funky-benefits__track" data-funky-carousel-track>
      {% for block in section.blocks %}
        <div class="funky-benefits__item" data-funky-carousel-item {{ block.shopify_attributes }}>
          <span class="funky-benefits__icon">
            {% case block.settings.icon %}
              {% when 'lock' %}
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="var(--funky-navy, #1f2049)" stroke-width="1.8">
                  <path d="M17 8V6a5 5 0 0 0-10 0v2"></path>
                  <rect x="5" y="8" width="14" height="12" rx="2"></rect>
                </svg>
              {% when 'person' %}
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="var(--funky-navy, #1f2049)" stroke-width="1.8">
                  <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                  <circle cx="12" cy="7" r="4"></circle>
                </svg>
              {% when 'leaf' %}
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="var(--funky-navy, #1f2049)" stroke-width="1.8">
                  <path d="M5 21c0-8 6-15 15-15 0 9-7 15-15 15Z"></path>
                  <path d="M5 21c0-4 2-8 6-11"></path>
                </svg>
              {% when 'heart' %}
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="var(--funky-navy, #1f2049)" stroke-width="1.8">
                  <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                </svg>
              {% when 'truck' %}
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="var(--funky-navy, #1f2049)" stroke-width="1.8">
                  <rect x="1" y="6" width="14" height="11" rx="1"></rect>
                  <path d="M15 10h4l3 3v4h-7z"></path>
                  <circle cx="6" cy="19" r="2"></circle>
                  <circle cx="17" cy="19" r="2"></circle>
                </svg>
              {% else %}
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="var(--funky-navy, #1f2049)" stroke-width="1.8">
                  <path d="M12 2 3 7v6c0 5 4 9 9 9s9-4 9-9V7l-9-5Z"></path>
                </svg>
            {% endcase %}
          </span>
          <div>
            <div class="funky-benefits__title">{{ block.settings.title }}</div>
            <div class="funky-benefits__subtitle">{{ block.settings.subtitle }}</div>
          </div>
        </div>
      {% endfor %}
    </div>

    <div class="funky-benefits__controls">
      <button type="button" class="funky-benefits__arrow" data-funky-carousel-prev aria-label="Vorige">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--funky-navy, #1f2049)" stroke-width="2"><path d="M15 18l-6-6 6-6"></path></svg>
      </button>
      <div class="funky-benefits__progress-track">
        <div class="funky-benefits__progress-fill" data-funky-carousel-progress></div>
      </div>
      <button type="button" class="funky-benefits__arrow" data-funky-carousel-next aria-label="Volgende">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--funky-navy, #1f2049)" stroke-width="2"><path d="M9 18l6-6-6-6"></path></svg>
      </button>
    </div>
  </funky-carousel>
</section>

{% stylesheet %}
  .funky-benefits {
    max-width: 1100px;
    margin: 0 auto;
    padding: 40px 48px;
    border-bottom: 1.5px solid rgba(31, 32, 73, 0.15);
    font-family: var(--funky-font-body, "Inter", sans-serif);
  }

  .funky-benefits__carousel {
    display: block;
  }

  .funky-benefits__track {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .funky-benefits__track::-webkit-scrollbar {
    display: none;
  }

  .funky-benefits__item {
    flex: 1 0 220px;
    scroll-snap-align: start;
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 20px 28px;
  }

  .funky-benefits__icon {
    flex-shrink: 0;
    display: inline-flex;
  }

  .funky-benefits__title {
    font-size: 15px;
    font-weight: 700;
    color: var(--funky-navy, #1f2049);
  }

  .funky-benefits__subtitle {
    font-size: 13px;
    color: #6f6f80;
  }

  .funky-benefits__controls {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-top: 20px;
  }

  .funky-benefits__arrow {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #fff;
    border: 1.5px solid rgba(31, 32, 73, 0.15);
    border-radius: 999px;
    cursor: pointer;
  }

  .funky-benefits__arrow:disabled {
    opacity: 0.35;
    cursor: default;
  }

  .funky-benefits__progress-track {
    flex: 1;
    height: 4px;
    background: rgba(31, 32, 73, 0.1);
    border-radius: 999px;
    overflow: hidden;
  }

  .funky-benefits__progress-fill {
    width: 0%;
    height: 100%;
    background: var(--funky-navy, #1f2049);
    border-radius: 999px;
    transition: width 150ms ease;
  }
{% endstylesheet %}

{% javascript %}
  class FunkyCarousel extends HTMLElement {
    connectedCallback() {
      this.track = this.querySelector('[data-funky-carousel-track]');
      this.prevButton = this.querySelector('[data-funky-carousel-prev]');
      this.nextButton = this.querySelector('[data-funky-carousel-next]');
      this.progressFill = this.querySelector('[data-funky-carousel-progress]');

      if (!this.track) return;

      this.onPrev = this.onPrev.bind(this);
      this.onNext = this.onNext.bind(this);
      this.onScroll = this.onScroll.bind(this);

      this.prevButton?.addEventListener('click', this.onPrev);
      this.nextButton?.addEventListener('click', this.onNext);
      this.track.addEventListener('scroll', this.onScroll, { passive: true });
      window.addEventListener('resize', this.onScroll);

      this.updateUI();
    }

    disconnectedCallback() {
      window.removeEventListener('resize', this.onScroll);
    }

    onPrev() {
      this.track.scrollBy({ left: -this.track.clientWidth, behavior: 'smooth' });
    }

    onNext() {
      this.track.scrollBy({ left: this.track.clientWidth, behavior: 'smooth' });
    }

    onScroll() {
      window.requestAnimationFrame(() => this.updateUI());
    }

    updateUI() {
      const maxScroll = this.track.scrollWidth - this.track.clientWidth;
      const progress = maxScroll > 0 ? this.track.scrollLeft / maxScroll : 0;

      if (this.progressFill) {
        this.progressFill.style.width = `${Math.max(0, Math.min(1, progress)) * 100}%`;
      }
      if (this.prevButton) this.prevButton.disabled = this.track.scrollLeft <= 1;
      if (this.nextButton) this.nextButton.disabled = this.track.scrollLeft >= maxScroll - 1;
    }
  }

  customElements.define('funky-carousel', FunkyCarousel);
{% endjavascript %}

{% schema %}
{
  "name": "Funky benefits",
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "shield", "label": "Shield" },
            { "value": "lock", "label": "Lock" },
            { "value": "person", "label": "Person" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "heart", "label": "Heart" },
            { "value": "truck", "label": "Truck" }
          ],
          "default": "shield"
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Benefit" },
        { "type": "text", "id": "subtitle", "label": "Subtitle" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Funky benefits",
      "blocks": [
        { "type": "benefit", "settings": { "icon": "shield", "title": "Handmade in Europe", "subtitle": "Kleinschalig vakmanschap" } },
        { "type": "benefit", "settings": { "icon": "lock", "title": "Duurzame materialen", "subtitle": "Bewust geproduceerd" } },
        { "type": "benefit", "settings": { "icon": "person", "title": "10.000+ tevreden klanten", "subtitle": "En groeiende" } }
      ]
    }
  ]
}
{% endschema %}
