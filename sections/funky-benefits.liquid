{% comment %}
  Trust bar with up to three benefit callouts (icon, title, subtitle).
{% endcomment %}

<section class="funky-benefits">
  {% for block in section.blocks %}
    <div class="funky-benefits__item" {{ block.shopify_attributes }}>
      <span class="funky-benefits__icon">{{ block.settings.icon }}</span>
      <div>
        <div class="funky-benefits__title">{{ block.settings.title }}</div>
        <div class="funky-benefits__subtitle">{{ block.settings.subtitle }}</div>
      </div>
    </div>
  {% endfor %}
</section>

{% stylesheet %}
  .funky-benefits {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    justify-items: center;
    align-items: stretch;
    gap: 32px;
    max-width: 1100px;
    margin: 0 auto;
    padding: 40px 48px;
    border-bottom: 1.5px solid rgba(31, 32, 73, 0.15);
  }

  .funky-benefits__item {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 20px 28px;
  }

  .funky-benefits__icon {
    flex-shrink: 0;
    font-size: 26px;
    line-height: 1;
  }

  .funky-benefits__title {
    font-size: 15px;
    font-weight: 700;
    color: var(--funky-navy, #1f2049);
  }

  .funky-benefits__subtitle {
    font-size: 13px;
    color: #6f6f80;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Funky benefits",
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon (emoji)", "default": "🛡️" },
        { "type": "text", "id": "title", "label": "Title", "default": "Benefit" },
        { "type": "text", "id": "subtitle", "label": "Subtitle" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Funky benefits",
      "blocks": [
        { "type": "benefit", "settings": { "icon": "🛡️", "title": "Handmade in Europe", "subtitle": "Kleinschalig vakmanschap" } },
        { "type": "benefit", "settings": { "icon": "🌱", "title": "Duurzame materialen", "subtitle": "Bewust geproduceerd" } },
        { "type": "benefit", "settings": { "icon": "💛", "title": "10.000+ tevreden klanten", "subtitle": "En groeiende" } }
      ]
    }
  ]
}
{% endschema %}
